# Shipment tracking (Supabase)
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Project Settings -> API
#
# The URL and the anon key are both safe to ship to the browser: RLS blocks
# anonymous reads on every table, and the public site can only reach shipment
# data through the `track_shipment` function.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER add the service_role key here. Vite inlines every VITE_ variable into
# the client bundle, so a VITE_ service-role key would be readable by anyone
# and would bypass RLS completely. Server-only secrets belong in serverless
# function environment variables, never in a VITE_ prefix.
